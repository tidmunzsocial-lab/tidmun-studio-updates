# Environment created separately on each machine
.venv312/

# Runtime data, downloaded AI tools/models, settings, and user exports
snapgen_data/
export/

# RIFE is downloaded to snapgen_data/tools on first use
snapgen_modules/rife-ncnn-vulkan/

# Python bytecode cache, except the application core required by the launcher
__pycache__/*
!__pycache__/snapgen_core.cpython-312.pyc
snapgen_modules/__pycache__/
tools/__pycache__/
vendor/**/__pycache__/

# Generated release package
tools/release/

# Runtime status and logs
snapgen_update_last.json
*.log

# Shortcuts and OS files
*.lnk
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
