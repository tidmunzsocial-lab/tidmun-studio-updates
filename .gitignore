# Virtual environments (each machine creates its own via setup_and_run.bat)
.venv312/

# Runtime data, AI model downloads, user settings
snapgen_data/

# User-generated exports (unique per user)
export/

# Backups and temp restore
snapgen_backups/
temp_restore/

# Python bytecode cache EXCEPT snapgen_core — that file is the real app
# and MUST be committed.  We ignore __pycache__ broadly then force-add core.
__pycache__/*
!__pycache__/snapgen_core.cpython-312.pyc

# OS junk
Thumbs.db
desktop.ini
*.lnk

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
# Virtual environments (each machine creates its own via setup_and_run.bat)
.venv312/

# Runtime data, AI model downloads, user settings
snapgen_data/

# User-generated exports (unique per user)
export/

# Backups and temp restore
snapgen_backups/
temp_restore/

# RIFE model downloaded automatically on first run (~448MB)
snapgen_modules/rife-ncnn-vulkan/

# Python bytecode cache EXCEPT snapgen_core — that file is the real app
# and MUST be committed.  Ignore everything in __pycache__ except core.
__pycache__/*
!__pycache__/snapgen_core.cpython-312.pyc

# snapgen_modules bytecode cache
snapgen_modules/__pycache__/

# vendor bytecode cache
vendor/**/__pycache__/

# Release zip (regenerated by build_update_patch.py)
tools/release/

# OS junk
Thumbs.db
desktop.ini

# Shortcuts (regenerated per machine)
*.lnk

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
